/* groovylint-disable CompileStatic */
pipeline {
    agent { label 'docker-linux' }

    parameters {
        choice(name: 'ONEC_USE_HW_LICENSES', choices: ['0', '1'],
               description: 'Поиск аппаратного ключа 1С: 0 — отключён, 1 — включён')
        string(name: 'TEST_IMAGE', defaultValue: '',
               description: 'Точный тег из metadata JSON скачанного TAR; образ загружен в Docker daemon агента')
    }

    stages {
        stage('Check tools') {
            steps {
                // Entrypoint готовит HOME, NSS и настройки 1С, затем ждёт Xvfb.
                // Добавьте команды 1С в bash -ec, чтобы они использовали один Xvfb.
                // Для VNC добавьте параметры из README перед "$TEST_IMAGE".
                sh '''
                    test -n "$TEST_IMAGE"
                    docker run --rm \\
                        --user "$(id -u):$(id -g)" \\
                        -e ONEC_USE_HW_LICENSES="$ONEC_USE_HW_LICENSES" \\
                        --mount "type=bind,src=$WORKSPACE,dst=/workspace" \\
                        --workdir /workspace \\
                        "$TEST_IMAGE" bash -ec '
                            id
                            vrunner version
                            ibcmd --help
                        '
                '''
            }
        }
    }
}
