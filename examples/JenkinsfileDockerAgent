/* groovylint-disable CompileStatic */
pipeline {
    agent {
        docker {
            label 'docker-linux'
            image "${params.TEST_IMAGE}"
            // Режим 1 для agent { docker }: entrypoint сразу запускает cat,
            // затем готовит HOME, NSS и настройки 1С и поднимает один Xvfb.
            // Режим 0 по умолчанию рассчитан на обычный docker run:
            // entrypoint готовит окружение и ждёт Xvfb перед командой.
            //
            // VNC по умолчанию выключен. Создайте пароль на Docker-хосте:
            // x11vnc -storepasswd /opt/jenkins-agent/shared/vnc/onec-test.passwd
            // Дайте UID контейнера право чтения и добавьте в строку args:
            //     -e ENABLE_VNC=1
            //     -e VNC_PASSWORD_FILE=/run/vnc-password
            //     -v /opt/jenkins-agent/shared/vnc/onec-test.passwd:/run/vnc-password:ro
            //     -p 127.0.0.1:5907:5900
            // Туннель: ssh -N -L 5907:127.0.0.1:5907 user@jenkins-agent
            // Адрес для VNC-клиента: 127.0.0.1:5907.
            args """
                -e ONEC_JENKINS_AGENT=1
                -e ONEC_USE_HW_LICENSES=${params.ONEC_USE_HW_LICENSES}
                -e HOME=/tmp/onec-jenkins
                -e NSS_WRAPPER_PASSWD=/tmp/onec-jenkins/passwd
                -e NSS_WRAPPER_GROUP=/tmp/onec-jenkins/group
                -e LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libnss_wrapper.so
            """
        }
    }
    parameters {
        choice(name: 'ONEC_USE_HW_LICENSES', choices: ['0', '1'],
               description: 'Поиск аппаратного ключа 1С: 0 — отключён, 1 — включён')
        string(name: 'TEST_IMAGE', defaultValue: '',
               description: 'Точный тег из metadata JSON скачанного TAR; образ загружен в Docker daemon агента')
    }
    stages {
        stage('Check tools') {
            steps {
                // Один раз на контейнер перед первой командой 1С.
                // Проверяем настройки окружения и подключение к Xvfb.
                sh '''
                  onec-wait-ready
                  id
                  vrunner version
                  ibcmd --help
                '''
                // Добавьте команды тестирования в следующие стадии.
            }
        }
    }
}
