pipeline {
    agent { label 'docker-linux' }
    parameters {
        string(name: 'TEST_IMAGE', defaultValue: 'odins-onec-test:8.3.27.2130-run',
               description: 'Образ уже доступен Docker daemon агента')
    }
    stages {
        stage('Check tools') {
            steps {
                script {
                    def uid = sh(script: 'id -u', returnStdout: true).trim()
                    def gid = sh(script: 'id -g', returnStdout: true).trim()
                    docker.image(params.TEST_IMAGE).inside("--user ${uid}:${gid}") {
                        sh 'id && vrunner --version && ibcmd --help'
                        // Здесь выполняется команда тестирования вашей конфигурации.
                    }
                }
            }
        }
    }
}
