pipeline {
    agent { label 'docker-linux' }
    parameters {
        string(name: 'TEST_IMAGE', defaultValue: 'odins-onec-test:8.3.27.2130-run',
               description: 'Образ уже доступен Docker daemon агента')
    }
    stages {
        stage('Check tools') {
            steps {
                sh '''
                  docker run --rm --user "$(id -u):$(id -g)" \
                    --mount "type=bind,src=$WORKSPACE,dst=/workspace" \
                    "$TEST_IMAGE" bash -ec 'id; vrunner --version; ibcmd --help'
                '''
                // Добавьте команду тестирования конфигурации в bash -ec выше.
            }
        }
    }
}
